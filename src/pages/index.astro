  <div id="toast" class="fixed left-1/2 -translate-x-1/2 bottom-5 z-50 hidden px-4 py-3 font-bold text-sm border-2 border-solid shadow-[4px_4px_0_#241a33]" style="background: var(--bk-pop); color: var(--bk-ink);" role="status" aria-live="polite"></div>

  <script type="application/json" id="templates-data" set:html={JSON.stringify(TEMPLATES)} />

  <script>
    // ---------- util ----------
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const rp = (n) => 'rp' + Math.round(n).toLocaleString('id-ID');
    const store = {
      read() { try { const v = JSON.parse(localStorage.getItem('bidkit-v1') || '{}'); return v && typeof v === 'object' ? v : {}; } catch { return {}; } },
      write(v) { try { localStorage.setItem('bidkit-v1', JSON.stringify(v)); } catch {} },
    };
    const state = Object.assign({ template: '', checks: [] }, store.read());
    const save = () => store.write(state);
    let toastTimer;
    function toast(msg) {
      const t = $('#toast');
      t.textContent = msg;
      t.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => t.classList.add('hidden'), 3200);
    }

    const TEMPLATES = JSON.parse($('#templates-data').textContent || '[]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lowPower = (navigator.hardwareConcurrency || 8) <= 4 || (navigator.deviceMemory || 8) <= 4 || (navigator.connection && navigator.connection.saveData);
    if (reduced || lowPower) document.documentElement.setAttribute('data-motion', 'off');

    // ---------- gerak: zoom-through kata raksasa + skew marquee ----------
    const word = $('#judul-bidkit');
    let lastY = window.scrollY, lastT = performance.now();
    function onScroll() {
      const y = window.scrollY, now = performance.now();
      const v = Math.abs(y - lastY) / Math.max(now - lastT, 1);
      lastY = y; lastT = now;
      if (document.documentElement.getAttribute('data-motion') === 'off') return;
      const p = Math.min(y / 600, 1);
      if (word) word.style.transform = `scale(${1 + p * 0.6}) rotate(${-p * 2}deg) translateX(${p * 30}px)`;
      const skew = Math.min(v * 8, 12);
      $$('[data-marquee]').forEach((m) => { m.style.transform = `skewX(${skew}deg)`; });
    }
    let ticking = false;
    window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(() => { onScroll(); ticking = false; }); ticking = true; } }, { passive: true });

    // reveal sections
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.08 });
    $$('.bk-reveal').forEach((el) => io.observe(el));

    // ---------- gerak toggle + marquee toggle ----------
    const motionBtn = $('#motion-toggle');
    function syncMotionBtn() {
      const off = document.documentElement.getAttribute('data-motion') === 'off';
      motionBtn.textContent = off ? 'gerak: mati' : 'gerak: nyala';
      motionBtn.setAttribute('aria-pressed', String(!off));
    }
    motionBtn.addEventListener('click', () => {
      const off = document.documentElement.getAttribute('data-motion') === 'off';
      if (off) document.documentElement.removeAttribute('data-motion');
      else document.documentElement.setAttribute('data-motion', 'off');
      syncMotionBtn();
    });
    syncMotionBtn();

    const mqBtn = $('#marquee-toggle');
    mqBtn.addEventListener('click', () => {
      const paused = mqBtn.getAttribute('aria-pressed') === 'true';
      $$('[data-marquee]').forEach((m) => { m.style.animationPlayState = paused ? '' : 'paused'; });
      mqBtn.setAttribute('aria-pressed', String(!paused));
      mqBtn.textContent = paused ? 'jeda marquee' : 'jalanin marquee';
    });

    // ---------- easter egg: klik kata 5x ----------
    let eggClicks = 0, eggTimer;
    word.addEventListener('click', () => {
      eggClicks++;
      clearTimeout(eggTimer);
      eggTimer = setTimeout(() => { eggClicks = 0; }, 2500);
      if (eggClicks >= 5) { eggClicks = 0; toast('makelarnya lagi ngopi, bentar ya.'); }
    });

    // ---------- template: tabs + pilih kartu ----------
    const cards = $$('.template-card');
    const tabs = $$('.bk-tab');
    function filterCat(cat) {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cat === cat)));
      cards.forEach((c) => { c.style.display = c.dataset.cat === cat ? '' : 'none'; });
    }
    tabs.forEach((t) => t.addEventListener('click', () => filterCat(t.dataset.cat)));
    tabs.forEach((t, i) => t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const n = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
        tabs[n].focus(); filterCat(tabs[n].dataset.cat);
      }
    }));

    // hover kartu ubah tema halaman (D)
    cards.forEach((c) => {
      c.addEventListener('mouseenter', () => { if (c.dataset.theme) document.documentElement.setAttribute('data-theme', c.dataset.theme); });
      c.addEventListener('mouseleave', () => document.documentElement.removeAttribute('data-theme'));
      c.addEventListener('focus', () => { if (c.dataset.theme) document.documentElement.setAttribute('data-theme', c.dataset.theme); });
      c.addEventListener('blur', () => document.documentElement.removeAttribute('data-theme'));
    });

    function selectTemplate(id, scroll = true) {
      const t = TEMPLATES.find((x) => x.id === id);
      if (!t) return;
      state.template = id; save();
      cards.forEach((c) => {
        const on = c.dataset.id === id;
        c.setAttribute('aria-pressed', String(on));
        c.style.outline = on ? '3px solid var(--bk-accent)' : '';
        c.style.background = on ? 'var(--bk-accent-soft)' : '';
      });
      $('#preview-template-name').textContent = 'template: ' + t.judul;
      filterCat(t.cat);
      renderProposal();
      if (scroll) $('#bid-form').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    }
    cards.forEach((c) => {
      c.addEventListener('click', () => selectTemplate(c.dataset.id));
      c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectTemplate(c.dataset.id); } });
    });

    // ---------- form + proposal ----------
    const form = $('#bid-form');
    const FIELDS = ['nama', 'pengalaman', 'durasi', 'keahlian', 'harga', 'portofolio', 'catatan', 'platform'];
    function formValues() {
      const v = {};
      FIELDS.forEach((f) => { const el = form.elements[f]; v[f] = el ? String(el.value).trim() : ''; });
      return v;
    }
    function fillForm(v) {
      FIELDS.forEach((f) => { const el = form.elements[f]; if (el && v[f] !== undefined) el.value = v[f]; });
    }
    function renderProposal() {
      const t = TEMPLATES.find((x) => x.id === state.template);
      const pre = $('#proposal-preview');
      if (!t) { pre.textContent = 'pilih template dulu, isi datamu — karcis ini keisi sendiri.'; return; }
      const v = formValues();
      let body = t.body;
      body = body.replaceAll('{nama}', v.nama || '[isi manual]');
      body = body.replaceAll('{pengalaman}', v.pengalaman || '[isi manual]');
      body = body.replaceAll('{durasi}', v.durasi || '[isi manual]');
      body = body.replaceAll('{keahlian}', v.keahlian || '[isi manual]');
      body = body.replaceAll('{harga}', v.harga ? Number(v.harga).toLocaleString('id-ID') : '[isi manual]');
      body = body.replaceAll('{portofolio}', v.portofolio || '[isi manual]');
      body = body.replaceAll('{catatan}', v.catatan || '[isi manual]');
      pre.textContent = body;
    }
    function validateForm() {
      const v = formValues();
      let ok = true;
      const setErr = (name, bad) => {
        const p = $(`[data-err="${name}"]`);
        if (p) p.classList.toggle('hidden', !bad);
        if (bad) ok = false;
      };
      setErr('nama', !v.nama);
      setErr('harga', !v.harga || Number(v.harga) < 1000);
      setErr('portofolio', !/^https:\/\//i.test(v.portofolio));
      $('#form-status').textContent = ok ? '' : 'masih ada yang kurang — cek pesan merah di atas.';
      return ok;
    }
    form.addEventListener('input', () => { state.form = formValues(); save(); renderProposal(); });
    form.addEventListener('change', () => { state.form = formValues(); save(); renderProposal(); });

    async function copyText(text, okMsg, failMsg) {
      try { await navigator.clipboard.writeText(text); toast(okMsg); return true; }
      catch {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); toast(okMsg); return true; }
        catch { toast(failMsg); return false; }
        finally { ta.remove(); }
      }
    }
    $('#copy-proposal').addEventListener('click', async () => {
      if (!state.template) { $('#copy-status').textContent = 'pilih template dulu, baru salin.'; return; }
      if (!validateForm()) { $('#copy-status').textContent = 'lengkapi dulu yang merah — proposal jangan dikirim setengah.'; return; }
      const ok = await copyText($('#proposal-preview').textContent, 'proposal tersalin — tinggal tempel di kolom bid.', 'gagal menyalin — izinkan clipboard atau salin manual dari karcis.');
      $('#copy-status').textContent = ok ? 'tersalin. tempel di projects.co.id / sribu, lalu kirim.' : '';
    });
    $('#download-proposal').addEventListener('click', () => {
      if (!state.template) { $('#copy-status').textContent = 'pilih template dulu, baru unduh.'; return; }
      const blob = new Blob([$('#proposal-preview').textContent], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `bidkit-${state.template}.txt`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      $('#copy-status').textContent = 'file .txt terunduh.';
    });
    $('#copy-link').addEventListener('click', async () => {
      const v = formValues();
      const q = new URLSearchParams();
      if (state.template) q.set('template', state.template);
      FIELDS.forEach((f) => { if (v[f]) q.set(f, v[f]); });
      const url = location.origin + location.pathname + '?' + q.toString();
      await copyText(url, 'tautan tersalin — buka di mana saja, isian ikut kebawa.', 'gagal menyalin tautan.');
    });

    // ---------- kalkulator ----------
    const calcIds = ['c-harga', 'c-hari', 'c-platform', 'c-fee-manual', 'c-bank', 'c-bmin', 'c-bmax'];
    function calc() {
      const harga = Number($('#c-harga').value || 0);
      const hari = Number($('#c-hari').value || 0);
      const plat = $('#c-platform').value;
      const feeManual = Number($('#c-fee-manual').value || 0);
      const transfer = Number($('#c-bank').value || 0);
      const bmin = Number($('#c-bmin').value || 0);
      const bmax = Number($('#c-bmax').value || 0);
      $('#c-fee-manual-wrap').classList.toggle('hidden', plat !== 'manual');
      if (!harga || harga < 1000) {
        ['#o-harga', '#o-fee', '#o-transfer', '#o-bersih', '#o-hari'].forEach((s) => $(s).textContent = '—');
        $('#o-verdict').textContent = 'isi harga dulu — hasilnya muncul di sini.';
        $('#o-saran').textContent = '';
        $('#calc-status').textContent = '';
        return;
      }
      const pct = plat === 'manual' ? feeManual : Number(plat);
      const fee = (harga * pct) / 100;
      const bersih = harga - fee - transfer;
      $('#o-harga').textContent = rp(harga);
      $('#o-fee').textContent = `${rp(fee)} (${pct}%)`;
      $('#o-transfer').textContent = transfer ? rp(transfer) : 'gratis';
      $('#o-bersih').textContent = rp(bersih);
      $('#o-hari').textContent = hari > 0 ? rp(bersih / hari) + ' / hari' : '— (isi hari kerja)';
      let verdict = '', saran = '';
      if (bmin > 0 && bmax > 0 && bmin <= bmax) {
        if (harga < bmin) { verdict = 'harga kamu di bawah budget klien — aman masuk, tapi cek lagi: jangan sampai kerja rodi.'; saran = 'coba naikkan sedikit sampai mendekati budget min, atau tambahkan bonus revisi sebagai nilai tambah.'; }
        else if (harga > bmax) { verdict = 'harga kamu di atas budget maks klien — kemungkinan besar tidak dipilih.'; saran = 'turunkan ke dalam rentang, atau tawar paket lebih kecil (kurangi lingkup) supaya masuk budget.'; }
        else { verdict = 'harga kamu masuk rentang budget klien — lanjut kirim bid.'; saran = 'tekankan nilai (portofolio + garansi revisi) supaya tidak kalah sama penawar termurah.'; }
      } else {
        verdict = bersih > 0 ? 'terima bersih ' + rp(bersih) + ' — kirim bid kalau angkanya sudah cocok di kantongmu.' : 'harga bersihmu nol atau minus — naikkan harga tawaranmu.';
        saran = plat === 'manual' ? 'fee sribu di atas itu tebakanmu sendiri — cek lagi ke sribu sebelum kirim.' : 'fee dihitung dari tarif resmi platform. cek biaya transfer: bank lain kena rp7.500.';
      }
      $('#o-verdict').textContent = verdict;
      $('#o-saran').textContent = saran;
      $('#calc-status').textContent = '';
    }
    calcIds.forEach((id) => { const el = document.getElementById(id); if (el) el.addEventListener('input', calc); });

    // ---------- checklist ----------
    const checkInputs = $$('.check-item');
    function syncChecks() {
      const done = state.checks.filter(Boolean).length;
      $('#check-count').textContent = String(done);
      $('#check-bar').style.width = (done / 12) * 100 + '%';
      $('#check-bar-wrap').setAttribute('aria-valuenow', String(done));
      $('#check-status').textContent = done === 12 ? 'semua beres — portofoliomu siap perang.' : done >= 6 ? 'setengah jalan — lanjutkan, klien suka yang rapi.' : '';
      checkInputs.forEach((el, i) => { el.checked = !!state.checks[i]; });
    }
    checkInputs.forEach((el, i) => el.addEventListener('change', () => { state.checks[i] = el.checked; save(); syncChecks(); }));
    $('#check-export').addEventListener('click', () => {
      const data = { tool: 'bidkit', versi: 1, tanggal: new Date().toISOString().slice(0, 10), checklist: state.checks.map((c, i) => ({ item: i + 1, beres: !!c })) };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = 'bidkit-checklist.json'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      $('#check-status').textContent = 'checklist terunduh sebagai json.';
    });
    $('#check-reset').addEventListener('click', () => { state.checks = []; save(); syncChecks(); $('#check-status').textContent = 'checklist diulang dari nol.'; });

    // ---------- deep-link + restore ----------
    (function init() {
      const q = new URLSearchParams(location.search);
      const saved = state.form || {};
      const fromUrl = {};
      FIELDS.forEach((f) => { if (q.get(f)) fromUrl[f] = q.get(f); });
      fillForm(Object.assign({}, saved, fromUrl));
      if (Array.isArray(state.checks) && state.checks.length !== 12) state.checks = Array(12).fill(false);
      if (!Array.isArray(state.checks)) state.checks = Array(12).fill(false);
      syncChecks();
      const tpl = q.get('template') || state.template;
      if (tpl) selectTemplate(tpl, false);
      filterCat('ui/ux');
      renderProposal();
      calc();
      // isi kalkulator dari form kalau ada
      if (formValues().harga) { $('#c-harga').value = formValues().harga; calc(); }
      if (formValues().durasi) { $('#c-hari').value = formValues().durasi; calc(); }
    })();
  </script>
</Layout>
